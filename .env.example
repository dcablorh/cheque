# ==============================================================================
# DIGITAL CHEQUES FOR GHANA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local and populate with your credentials.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database & Cache (pre-configured for docker-compose)
DATABASE_URL=postgresql://cheque_user:cheque_password@localhost:5432/cheque_db
REDIS_URL=redis://localhost:6379

# Stellar Network & Soroban RPC
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Circle Official Testnet USDC Configuration
# Citation: https://developers.circle.com/stablecoins/docs/quickstart-transfer-10-usdc-on-chain
# Faucet: https://faucet.circle.com/
USDC_ISSUER_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC

# Deployed Soroban Cheque Escrow Contract ID
CHEQUE_CONTRACT_ID=

# Stellar Account Public Keys (Generated via `pnpm bootstrap:testnet`)
CONTRACT_ADMIN_PUBLIC=
CLAIM_AUTHORITY_PUBLIC=
GUARDIAN_PUBLIC=
FUNDING_ACCOUNT_PUBLIC=
SETTLEMENT_ACCOUNT_PUBLIC=
FEE_SOURCE_PUBLIC=

# Stellar Account Secrets (Store securely in KMS or .env.local; NEVER commit!)
CONTRACT_ADMIN_SECRET=
CLAIM_AUTHORITY_SECRET=
GUARDIAN_SECRET=
FUNDING_ACCOUNT_SECRET=
SETTLEMENT_ACCOUNT_SECRET=
FEE_SOURCE_SECRET=
CHANNEL_ACCOUNT_SECRETS=

# SeevCash Ghana MoMo Sandbox & Webhooks
# Citation: https://seevcash.com
SEEV_CASH_BASE_URL=https://sandbox.seevcash.com
SEEV_CASH_API_KEY=
SEEV_CASH_WEBHOOK_SECRET=

# Transactional email (Resend) — sender login OTP, payee claim OTP and cheque notifications
EMAIL_API_KEY=

# Web & API App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3001

# Security Salts & Tokens
JWT_SECRET=development_jwt_secret_change_for_production_use
OTP_SALT=development_otp_salt_change_for_production_use

# Observability
SENTRY_DSN=

# Transactional email (Resend) for payee OTP and cheque-received messages
EMAIL_API_KEY=

# Pricing placeholders (GHS per 1 USDC, fee in basis points)
FX_GHS_PER_USDC=15.500000
# Corridors that accept new cheques (GH, NG, US).
ENABLED_CORRIDORS=GH,NG,US
# FX placeholders per 1 USD. Replace with live rates from the SEP-38 quote service before launch.
FX_NGN_PER_USDC=1550.000000
FX_USD_PER_USDC=1.000000
FEE_BPS=100

# Circle CCTP V2 (Stellar source). Testnet defaults are used when these are omitted.
# USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# CCTP_TOKEN_MESSENGER_MINTER=CDNG7HXAPBWICI2E3AUBP3YZWZELJLYSB6F5CC7WLDTLTHVM74SLRTHP
# IRIS_API_URL=https://iris-api-sandbox.circle.com
# SOLANA_RPC_URL=https://api.devnet.solana.com
