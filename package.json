{
  "name": "digital-cheques-ghana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @cheque/api dev",
    "dev:web": "pnpm --filter @cheque/web dev",
    "bootstrap:testnet": "tsx scripts/bootstrap-testnet.ts",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "e2e:cheque": "tsx scripts/e2e-cheque-flow.ts",
    "e2e:refund": "tsx scripts/e2e-refund-flow.ts",
    "test:integration": "tsx scripts/testnet-integration-acceptance.ts",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "@types/node": "^20.17.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
