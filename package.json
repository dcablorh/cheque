{
  "name": "digital-cheques-ghana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @cheque/api dev",
    "dev:web": "pnpm --filter @cheque/web dev",
    "bootstrap:testnet": "tsx scripts/bootstrap-testnet.ts",
    "build:contract": "cargo build --release --target wasm32v1-none --manifest-path contract/Cargo.toml -p cheque-contract",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "e2e:contract": "tsx scripts/e2e-contract-flow.ts",
    "e2e:wallet": "tsx scripts/e2e-wallet-flow.ts",
    "lint": "pnpm -r run lint",
    "spike:cctp": "tsx scripts/cctp-spike.ts"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "@types/node": "^20.17.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "viem": "^2.38.0",
    "@solana/web3.js": "^1.98.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
